{
  "version": "2.0.0",
  "tasks": [
    { "label": "lint", "type": "npm", "script": "lint", "problemMatcher": [] },
    { "label": "test", "type": "npm", "script": "test", "problemMatcher": [] },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      // tsc 타입 오류를 문제(Problems) 패널에 표시
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "check",
      // lint → test → build 순서로, 앞이 실패하면 멈춤
      "dependsOn": ["lint", "test", "build"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
